# MazaTowel admin credentials
ADMIN_EMAIL=admin@mazatowel.in
ADMIN_PASSWORD=change-this-password

# Google Places API (New) - server-side only
# Keep this secret on the server. Do not put it in frontend JavaScript.
GOOGLE_PLACES_API_KEY=
# Optional fallback if you do not want to store the Place ID in data/settings.json
GOOGLE_PLACE_ID=
