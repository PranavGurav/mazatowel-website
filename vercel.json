{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/react-build/admin.html"
    },
    {
      "source": "/admin.html",
      "destination": "/react-build/admin.html"
    },
    {
      "source": "/((?!api|react-build|assets|uploads|favicon).*)",
      "destination": "/react-build/index.html"
    }
  ]
}
